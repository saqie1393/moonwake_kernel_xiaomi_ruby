[
  {
    "kernelSource": {
      "name": "MoonWake",
      "repo": "https://github.com/saqie1393/moonwake_kernel_xiaomi_ruby",
      "branch": "moon",
      "device": "ruby",
      "vendor": "xiaomi",
      "defconfig": "ruby_defconfig"
    },
    "toolchains": [
      {
        "name": "clang",
        "repo": "https://github.com/crdroidandroid/android_prebuilts_clang_host_linux-x86_clang-r530567",
        "branch": "14.0",
        "binPath": ["bin"]
      }
    ],
    "params": {
      "ARCH": "arm64",
      "CC": "clang",
      "externalCommand": {
        "CROSS_COMPILE": "aarch64-linux-gnu-",
        "CLANG_TRIPLE": "aarch64-linux-gnu-",
        "LD": "ld.lld",
        "AR": "llvm-ar",
        "NM": "llvm-nm",
        "OBJCOPY": "llvm-objcopy",
        "OBJDUMP": "llvm-objdump",
        "READELF": "llvm-readelf",
        "LLVM": "1",
        "LLVM_IAS": "1"
      }
    },
    "AnyKernel3": {
      "use": true,
      "repo": "https://github.com/osm0sis/AnyKernel3",
      "branch": "master"
    },
    "output_image": "Image.gz-dtb",
    "ccache": true,
    "kernelsu": {
      "enable": false
    },
    "kp": {
      "use": false
    }
  }
]
